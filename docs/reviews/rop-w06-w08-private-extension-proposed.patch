+/** Review-gated W6–W8 binding registry. Deliberately EMPTY until exact input review,
+ * code review and purpose receipts exist. No fall-through to old W1–W5 pins.
+ * Future populated bindings must be source-generated from pinned private review packets.
+ */
+import type { OfflineBinding } from './weeklyAllocationFromDataV1.ts';
+export const PRIVATE_EXTENSION_BINDINGS: Partial<Readonly<Record<6 | 7 | 8, OfflineBinding>>> = Object.freeze({});
