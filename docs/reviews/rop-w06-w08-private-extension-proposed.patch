+++ b/tests/privateExtensionGate.test.ts
@@ -0,0 +1,24 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { adaptPrivateExtensionAllocation, adaptPrivateReleaseAllocation, verifyExtensionAcquisitionScope } from '../src/adapters/weeklyAllocationFromDataV1.ts';
+const output={artifactId:'test-private-extension',revision:'1',generatedAt:'2026-11-03T12:30:00Z'};
+test('new extension never reuses the original W1–W5 review or sealed binding',()=>{
+ for(const week of [6,7,8])
+  assert.throws(()=>adaptPrivateExtensionAllocation(new Map(),output,{season:2026,seasonType:'REG',week} as any),/sealed, independently reviewed private extension binding required/);
+});
+test('extension rejects invalid season, type, week, or extra scope keys before input access',()=>{
+ for(const scope of [{season:2025,seasonType:'REG',week:6},{season:2026,seasonType:'POST',week:6},{season:2026,seasonType:'REG',week:5},{season:2026,seasonType:'REG',week:9},{season:2026,seasonType:'REG',week:6,extra:true}])
+  assert.throws(()=>adaptPrivateExtensionAllocation(new Map(),output,scope as any),/private extension scope/);
+});
+test('old private release still rejects extension weeks',()=>{
+ for(const week of [6,7,8])
+  assert.throws(()=>adaptPrivateReleaseAllocation(new Map(),output,{season:2026,seasonType:'REG',week} as any),/private release scope/);
+});
+
+test('retrospective W6 explicitly retains the original W7 acquisition receipt',()=>{
+ assert.doesNotThrow(()=>verifyExtensionAcquisitionScope({season:2026,seasonType:'REG',week:6},{season:2026,season_type:'REG',week:7},7));
+ assert.doesNotThrow(()=>verifyExtensionAcquisitionScope({season:2026,seasonType:'REG',week:7},{season:2026,season_type:'REG',week:7},7));
+ assert.throws(()=>verifyExtensionAcquisitionScope({season:2026,seasonType:'REG',week:6},{season:2026,season_type:'REG',week:8},8),/unsupported retrospective source scope/);
+ assert.throws(()=>verifyExtensionAcquisitionScope({season:2026,seasonType:'REG',week:6},{season:2026,season_type:'REG',week:6},7),/retrospective acquisition receipt scope/);
+ assert.throws(()=>verifyExtensionAcquisitionScope({season:2026,seasonType:'REG',week:7},{season:2026,season_type:'REG',week:6},6),/unsupported retrospective source scope/);
+});